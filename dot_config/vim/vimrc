" XDG Base Directory support for runtimepath/packpath
" (native on vim 9.2+; explicit here so it also works on older vim)
set runtimepath^=$XDG_CONFIG_HOME/vim
set runtimepath+=$XDG_CONFIG_HOME/vim/after
let &packpath = &runtimepath

" Not compatible with the old-fashion vi mode
set nocompatible
" Encoding utf-8
set encoding=utf-8
" Info file
set viminfofile=$XDG_CONFIG_HOME/vim/viminfo
" Colors
set notermguicolors
" No backup or swap, autoread file when external edited
set nobackup nowritebackup noswapfile autoread
" Search
set hlsearch incsearch ignorecase smartcase
" Show cursor position in status bar
set ruler
" Show absolute line number of the current line
set number
" Disable unloading of buffers
set hidden
" Set shorter delays
set timeoutlen=1000 ttimeoutlen=10 updatetime=100
" Remove current mode status
set noshowmode
set laststatus=2
" Disable code folding
set nofoldenable
" Set maximum number of tabs
set tabpagemax=50
" Scroll the window so we can always see 10 lines around the cursor
set scrolloff=10
" Turn off alt shortcuts
set winaltkeys=no
" Disable annoying sound on errors
set noerrorbells
set novisualbell
set vb t_vb=
" Set ident defaults
set tabstop=4 softtabstop=4 shiftwidth=4 expandtab
" Show special chars
set list
set listchars=eol:⏎,tab:␉·,trail:␠,nbsp:⎵
" Syntax highlighing
syntax on
filetype plugin indent on

" Netrw
let g:netrw_banner = 0
let g:netrw_winsize = 25
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_altv = 1
let g:netrw_keepdir = 0
nnoremap <Leader>f :Lexplore<CR>

" Shortcuts
inoremap <script> <silent> <buffer> time<Tab> <C-R>=strftime("%H:%M")<CR>
inoremap <script> <silent> <buffer> date<Tab> <C-R>=strftime("%Y-%m-%d")<CR>
noremap <C-w>- :split<CR>
noremap <C-w>\ :vsplit<CR>

" Use Vim's built-in defaults and the terminal's ANSI palette.
colorscheme default
set background=dark

" Keep foot's default foreground and use its black background.
highlight Normal       cterm=NONE      ctermfg=NONE ctermbg=0
highlight Comment      cterm=italic    ctermfg=8    ctermbg=NONE gui=italic

" Syntax colours use only the terminal's 16 configurable colours.
highlight Constant     cterm=NONE      ctermfg=13   ctermbg=NONE
highlight String       cterm=NONE      ctermfg=2    ctermbg=NONE
highlight Identifier   cterm=NONE      ctermfg=6    ctermbg=NONE
highlight Statement    cterm=NONE      ctermfg=11   ctermbg=NONE
highlight PreProc      cterm=NONE      ctermfg=12   ctermbg=NONE
highlight Type         cterm=NONE      ctermfg=10   ctermbg=NONE
highlight Special      cterm=NONE      ctermfg=14   ctermbg=NONE

" Keep whitespace markers and line numbers unobtrusive.
highlight NonText      cterm=NONE      ctermfg=8    ctermbg=0
highlight SpecialKey   cterm=NONE      ctermfg=8    ctermbg=0
highlight LineNr       cterm=NONE      ctermfg=8    ctermbg=0
highlight CursorLineNr cterm=bold      ctermfg=11   ctermbg=0
highlight VertSplit    cterm=NONE      ctermfg=8    ctermbg=0

" Clear selection, search and completion highlighting.
highlight Visual       cterm=reverse   ctermfg=NONE ctermbg=NONE
highlight Search       cterm=NONE      ctermfg=0    ctermbg=11
highlight IncSearch    cterm=reverse   ctermfg=NONE ctermbg=NONE
highlight Pmenu        cterm=NONE      ctermfg=7    ctermbg=0
highlight PmenuSel     cterm=NONE      ctermfg=0    ctermbg=6

" Lightline
let g:lightline = {
    \ 'colorscheme': '16color',
    \ 'active': {
    \   'left': [ [ 'mode', 'paste' ],
    \             [ 'gitbranch', 'readonly', 'filename', 'modified' ] ]
    \ },
    \ 'component_function': {
    \   'gitbranch': 'FugitiveHead'
    \ },
\ }

" CtrlP
let g:ctrlp_cmd = 'CtrlPMixed'
let g:ctrlp_show_hidden = 1
let g:ctrlp_working_path_mode = 'ra'
let g:ctrlp_max_files = 500
let g:ctrlp_user_command = ['.git', 'cd %s && git ls-files -co --exclude-standard']

