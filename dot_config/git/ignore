# Global ignores: personal/OS/editor noise and safety nets only.
# Project artifacts belong in each repo's own .gitignore.
# Never ignore lockfiles here (uv.lock, package-lock.json, Cargo.lock, ...): they must be committed.

# Secrets (safety net)
.env
.env.*
!.env.example
!.env.sample

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Compiled artifacts
*.class
*.dll
*.exe
*.o
*.so

# Editors
*.swp
*.swo
*~
*.iml

# Archives (repos that commit fixtures or gradle-wrapper.jar: use a repo-level !negation)
*.7z
*.dmg
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and local databases
*.log
*.sqlite

# OS generated files
.DS_Store*
.directory
.nfs*
.Trash-*
Thumbs.db
ehthumbs.db
