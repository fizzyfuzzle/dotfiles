{
  "spacing": 12,
  "modules-left": ["sway/workspaces","sway/scratchpad","sway/mode"],
  "modules-center": [],
  "modules-right": ["load","memory","temperature","disk","network","custom/vpn","tray","battery","clock"],
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
   "sway/mode": {
    "format": " {}"
  },
  "load": {
    "format": " {load1:0.2f}"
  },
  "memory": {
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}GB used out of {total:0.1f}GB"
  },
  "temperature": {
    "format": " {temperatureC}°C",
    "tooltip": false
  },
  "disk": {
    "format": " {percentage_used}%",
    "path": "/home",
    "tooltip-format": "{specific_used:0.1f}GB used out of {specific_total:0.1f}GB on {path}",
    "unit": "GB"
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": " {essid}",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": " {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": " {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "on-click-right": "nm-connection-editor"
  },
  "custom/vpn": {
    "interval": 5,
    "exec": "~/.config/waybar/vpn-helper.sh",
    "format": "{icon}",
    "format-icons": {
      "connected": "⇄",
      "disconnected": ""
    },
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "tooltip-format": "{text}"
  },
  "tray": {
    "spacing": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-full": "",
    "format-icons": ["", "", "", "", ""]
  },
  "pulseaudio": {
    "ignored-sinks": ["Dummy Output"],
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "format-muted": " {volume}%"
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%d-%m-%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  }
}
