# Workstation Tools
{{- if .workstation }}
[".local/share/age"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL "FiloSottile/age" "v1.3.2" "age-*-linux-amd64.tar.gz" | quote }}
    exact = true
    stripComponents = 1
    checksum.sha256 = "cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10"
[".local/share/age-plugin-yubikey"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL "str4d/age-plugin-yubikey" "v0.5.0" "age-plugin-yubikey-*-x86_64-linux.tar.gz" | quote }}
    exact = true
    stripComponents = 1
    checksum.sha256 = "019b35a13fc81be56d73d0723db0a2082fbd04c936c2c6836381111f7f51b2c3"
# Not .local/share/uv: that is the uv data dir (managed Pythons, tools),
# which exact = true would make chezmoi delete.
[".local/share/uv-bin"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL "astral-sh/uv" "0.13.9" "uv-x86_64-unknown-linux-gnu.tar.gz" | quote }}
    exact = true
    stripComponents = 1
    checksum.sha256 = "a7fbaff2b9a271d85c1bdb540941090fd1ce011797b4abeb48e4dcd39c2471d5"
[".local/share/opentofu"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL "opentofu/opentofu" "v1.13.9" "tofu_*_linux_amd64.tar.gz" | quote }}
    exact = true
    checksum.sha256 = "b34b327cc1ef07178207b6f2cd1f5276537d3e5b7be316500f6dac50d4c0a857"
{{- end }}
