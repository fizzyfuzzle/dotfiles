# Workstation Tools
{{- if .workstation }}
[".local/share/age"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL .externals.age.repo .externals.age.version "age-*-linux-amd64.tar.gz" | quote }}
    exact = true
    stripComponents = 1
    checksum.sha256 = {{ .externals.age.checksum | quote }}
[".local/share/age-plugin-yubikey"]
    type = "archive"
    url = {{ gitHubReleaseAssetURL .externals.agePluginYubikey.repo .externals.agePluginYubikey.version "age-plugin-yubikey-*-x86_64-linux.tar.gz" | quote }}
    exact = true
    stripComponents = 1
    checksum.sha256 = {{ .externals.agePluginYubikey.checksum | quote }}
{{- end }}
