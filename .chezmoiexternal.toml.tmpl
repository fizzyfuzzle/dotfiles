# ZSH Plugins
[".local/share/zsh/plugins/zsh-autosuggestions"]
    type = "git-repo"
    url = "https://github.com/{{ .externals.zshPlugins.zshAutosuggestions.repo }}.git"
    revision = {{ .externals.zshPlugins.zshAutosuggestions.revision | quote }}
[".local/share/zsh/plugins/zsh-history-substring-search"]
    type = "git-repo"
    url = "https://github.com/{{ .externals.zshPlugins.zshHistorySubstringSearch.repo }}.git"
    revision = {{ .externals.zshPlugins.zshHistorySubstringSearch.revision | quote }}
[".local/share/zsh/plugins/zsh-syntax-highlighting"]
    type = "git-repo"
    url = "https://github.com/{{ .externals.zshPlugins.zshSyntaxHighlighting.repo }}.git"
    revision = {{ .externals.zshPlugins.zshSyntaxHighlighting.revision | quote }}

