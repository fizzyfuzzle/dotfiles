#!/usr/bin/env zsh
#
# File-backed LUKS2 containers unlocked by age-encrypted key files, after tomb.
#
emulate -R zsh
setopt pipe_fail
umask 077

TARGETMOUNT=${LUKS_TARGETMOUNT:-$HOME/luks}
STEGHIDE=(toolbox run steghide)

MAPPER= SECRET= MADE_DIR= CLEANUP=0

_info()    { print -r -- $'\e[0;32m'"$1"$'\e[0m' }
_warning() { print -ru2 -- $'\e[0;33m'"$1"$'\e[0m' }
_die()     { print -ru2 -- $'\e[0;31m'"$1"$'\e[0m'; exit 1 }

# Undoes a lock or open that failed halfway, so the mapper is not left open.
# Traps live at top level: in zsh an EXIT trap set inside a function fires when
# that function returns, and INT/TERM/HUP must exit or zsh resumes the script.
_cleanup() {
    (( CLEANUP )) || return 0
    [[ -n $MADE_DIR ]] && rmdir -- $MADE_DIR 2>/dev/null
    [[ -e /dev/mapper/$MAPPER ]] && sudo cryptsetup luksClose $MAPPER
    return 0
}
trap _cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

_need() { [[ -n $2 ]] || _die "NO $1 SPECIFIED" }

# Sets MAPPER from the container's resolved path, so open and close agree on it.
_mapper() {
    [[ -e $1 ]] || _die "'$1' NOT FOUND"
    MAPPER=luks.${"$(realpath -- $1 | sha256sum)"%% *}
}

# Sets SECRET, so lock decrypts the key file only once. Command substitution
# drops trailing newlines from the binary key; existing containers were
# formatted with the key stripped that way, so it must stay. Opening one by hand
# needs the same stripping.
_secret() {
    [[ -r $1 ]] || _die "KEY FILE NOT FOUND"
    SECRET=$(age -d -- $1) && [[ -n $SECRET ]] || _die "DECRYPTING KEY FILE FAILED"
}

_luks_open() {
    print -rn -- $SECRET | sudo cryptsetup --key-file - luksOpen $1 $MAPPER || _die "LUKS OPEN FAILED"
}

_read_pass() {
    read -rs "REPLY?ENTER PASSPHRASE: " && print || { print; exit 1 }
    [[ -n $REPLY ]] || _die "EMPTY PASSPHRASE"
    PASS=$REPLY
    (( ${1:-0} )) || return 0
    read -rs "REPLY?RETYPE PASSPHRASE: " && print || { print; exit 1 }
    [[ $REPLY == "$PASS" ]] || _die "PASSPHRASES DO NOT MATCH"
}

_is_jpeg() { [[ $(file -b --mime-type -- $1) == image/jpeg ]] }

# DIG TARGET: a file of random data, so used and unused space look the same.
_dig() {
    _need TARGET ${1-}
    local size=${2:-100}
    [[ ! -e $1 ]] || _die "TARGET ALREADY EXISTS"
    [[ $size == <1-> ]] || _die "'$size' IS NOT A SIZE IN MiB"
    head -c ${size}M /dev/urandom > $1 || { rm -f -- $1; _die "DIG TARGET FAILED" }
}

# FORGE KEY: 512 random bytes, encrypted with an age passphrase.
_forge() {
    _need "KEY FILE" ${1-}
    [[ ! -e $1 ]] || _die "KEY FILE ALREADY EXISTS"
    head -c 512 /dev/urandom | age -a -p -o $1 || { rm -f -- $1; _die "FORGE KEY FAILED" }
}

# LOCK TARGET WITH KEY: destroys what is in TARGET, so it refuses LUKS
# containers and asks before formatting a block device such as a microSD card.
_lock() {
    _need TARGET ${1-}
    _need "KEY FILE" ${2-}
    local target=${1:A}
    [[ -f $target || -b $target ]] || _die "'$1' IS NOT A FILE OR BLOCK DEVICE"
    sudo cryptsetup isLuks $target 2>/dev/null && _die "'$1' IS ALREADY A LUKS CONTAINER"
    if [[ -b $target ]]; then
        lsblk -o NAME,SIZE,MODEL,MOUNTPOINTS -- $target
        read -qs "?FORMAT $target? ALL DATA ON IT WILL BE LOST. [y/N] " && print || { print; exit 1 }
    fi
    _mapper $target
    [[ ! -e /dev/mapper/$MAPPER ]] || _die "'$1' IS ALREADY OPEN"
    _secret $2

    print -rn -- $SECRET | sudo cryptsetup --type luks2 --key-file - --batch-mode \
        --cipher aes-xts-plain64 --key-size 512 --hash sha512 --key-slot 0 \
        luksFormat $target || _die "LUKS FORMAT FAILED"
    CLEANUP=1
    _luks_open $target
    sudo mkfs.ext4 -q -L LUKS -E root_owner=$UID:$GID /dev/mapper/$MAPPER || _die "EXT4 FORMAT FAILED"
    sync
    sudo cryptsetup luksClose $MAPPER || _die "LUKS CLOSE FAILED"
    CLEANUP=0
}

# OPEN CONTAINER
_open() {
    _need TARGET ${1-}
    _need "KEY FILE" ${2-}
    local target=${1:A} usage
    _mapper $target
    [[ ! -e /dev/mapper/$MAPPER ]] || _die "'$1' IS ALREADY OPEN"
    [[ ! -e $TARGETMOUNT ]] || _die "MOUNTPOINT ALREADY EXISTS"
    sudo cryptsetup isLuks $target 2>/dev/null || _die "'$1' IS NO VALID LUKS CONTAINER"
    _secret $2

    CLEANUP=1
    _luks_open $target
    # fsck exit status 1 means that errors were found and corrected.
    sudo fsck -p -C0 /dev/mapper/$MAPPER > /dev/null
    (( $? <= 1 )) || _die "FSCK FAILED"
    mkdir -p -- $TARGETMOUNT && MADE_DIR=$TARGETMOUNT || _die "CREATE MOUNTPOINT FAILED"
    sudo mount -o rw,noatime,nodev,nosuid /dev/mapper/$MAPPER $TARGETMOUNT || _die "MOUNT FAILED"
    CLEANUP=0

    usage=$(df -hP $TARGETMOUNT | awk 'NR>1{print "FREE: " $4 " | USAGE: " $5}')
    _info "[$TARGETMOUNT] $usage"
}

# CLOSE CONTAINER: unmounts TARGETMOUNT only if this container is mounted there.
_close() {
    _need TARGET ${1-}
    _mapper ${1:A}
    local source
    if [[ -d $TARGETMOUNT ]]; then
        source=$(findmnt -n -o SOURCE --mountpoint $TARGETMOUNT)
        if [[ -n $source ]]; then
            [[ ${source:A} == ${${:-/dev/mapper/$MAPPER}:A} ]] || _die "$TARGETMOUNT IS NOT MOUNTED FROM '$1'"
            sudo umount $TARGETMOUNT || _die "UMOUNT FAILED"
        fi
        rmdir -- $TARGETMOUNT || _warning "REMOVE MOUNTPOINT FAILED"
    fi
    if [[ -e /dev/mapper/$MAPPER ]]; then
        sudo cryptsetup luksClose $MAPPER || _die "LUKS CLOSE FAILED"
    fi
}

# EMBED KEY INTO IMAGE: the armor lines are dropped to save space, exhume adds them back.
_bury() {
    _need "KEY FILE" ${1-}
    _need IMAGE ${2-}
    [[ -r $1 ]] || _die "KEY FILE NOT FOUND"
    [[ -r $2 ]] || _die "IMAGE FILE NOT FOUND"
    _is_jpeg $2 || _die "IMAGE FILE NOT JPG"
    _read_pass 1
    sed '/^-----/d' -- $1 | $STEGHIDE embed -q -ef - -cf $2 -p $PASS -e serpent cbc -z 9 \
        || _die "STEGHIDE EMBED FAILED"
}

# EXTRACT KEY FROM IMAGE
_exhume() {
    _need IMAGE ${1-}
    _need "KEY FILE" ${2-}
    [[ -r $1 ]] || _die "IMAGE FILE NOT FOUND"
    _is_jpeg $1 || _die "IMAGE FILE NOT JPG"
    [[ ! -e $2 ]] || _die "KEY FILE ALREADY EXISTS"
    _read_pass
    local body
    body=$($STEGHIDE extract -q -sf $1 -xf - -p $PASS) || _die "STEGHIDE EXTRACT FAILED"
    print -rl -- '-----BEGIN AGE ENCRYPTED FILE-----' $body '-----END AGE ENCRYPTED FILE-----' > $2
}

_usage() {
    print -r -- 'usage: luks dig TARGET [SIZE_MIB]
       luks forge KEY
       luks lock TARGET KEY
       luks open TARGET KEY
       luks close TARGET
       luks bury KEY IMAGE
       luks exhume IMAGE KEY'
}

case ${1-} in
    dig|forge|lock|open|close|bury|exhume) cmd=$1; shift; _$cmd "$@" ;;
    ''|help|-h|--help) _usage ;;
    *) _usage >&2; exit 1 ;;
esac
