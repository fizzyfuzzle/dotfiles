#!/usr/bin/env zsh
#
# Minimal passage-compatible password store: age-encrypted files, optionally in git.
#
emulate -R zsh
setopt pipe_fail
umask 077

PREFIX=${PASSAGE_DIR:-$HOME/.passage/store}
IDENTITIES_FILE=${PASSAGE_IDENTITIES_FILE:-$HOME/.passage/identities}
CLIP_TIME=10
GEN_LENGTH=30
GEN_CHARS='[:alnum:]!@#$%^&*()_+[];:,.?'
QRENCODE=(toolbox run qrencode -t utf8)
export GIT_CEILING_DIRECTORIES=$PREFIX/..

SECURE_TMPDIR= ENC_TMP= INNER_GIT_DIR=

_info() { print -r -- $'\e[0;32m'"$1"$'\e[0m' }
_die()  { print -ru2 -- $'\e[0;31m'"$1"$'\e[0m'; exit 1 }

# Traps live at top level: in zsh an EXIT trap set inside a function fires when
# that function returns. INT/TERM/HUP must exit, otherwise zsh resumes the script
# after the handler, e.g. encrypting a half-typed passphrase.
_cleanup() {
    [[ -n $SECURE_TMPDIR ]] && rm -rf -- $SECURE_TMPDIR
    [[ -n $ENC_TMP ]] && rm -f -- $ENC_TMP
    return 0
}
trap _cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

_check_path() {
    local p
    for p; do [[ /$p/ == */../* ]] && _die "SNEAKY PATH FAILURE"; done
    return 0
}

# Sets TARGET and FILE from a store path; rejects empty and ".." paths.
_target() {
    TARGET=${1%/}
    [[ -n $TARGET ]] || _die "NO TARGET SPECIFIED"
    _check_path $TARGET
    FILE=$PREFIX/$TARGET.age
}

_confirm_overwrite() {
    [[ -e $FILE ]] || return 0
    read -qs "?'$TARGET' ALREADY EXISTS. OVERWRITE? [y/N] " && print || { print; exit 1 }
}

_decrypt() { age -d -i $IDENTITIES_FILE "$@" }

# Nearest .age-recipients from the file's directory up to $PREFIX, else the identities.
_set_recipients() {
    local dir=${1:h}
    while [[ $dir == $PREFIX/* && ! -f $dir/.age-recipients ]]; do dir=${dir:h}; done
    if [[ -f $dir/.age-recipients ]]; then
        AGE_RECIPIENT_ARGS=(-R $dir/.age-recipients)
    else
        AGE_RECIPIENT_ARGS=(-i $IDENTITIES_FILE)
    fi
}

# Usage: _encrypt FILE COMMAND [ARG...]
# Encrypts COMMAND's output into FILE. FILE is replaced only if COMMAND and age
# both succeed, so a failed decrypt or an aborted prompt never truncates an entry.
_encrypt() {
    local file=$1; shift
    _set_recipients $file
    mkdir -p -- ${file:h} && ENC_TMP=$(mktemp -- "$file.XXXXXX") || return
    if "$@" | age -e $AGE_RECIPIENT_ARGS -o $ENC_TMP; then
        mv -f -- $ENC_TMP $file
    else
        rm -f -- $ENC_TMP
        false
    fi
    local rc=$?
    ENC_TMP=
    return rc
}

_git_commit() {
    [[ -n $INNER_GIT_DIR ]] || return 0
    local msg=$1; shift
    git -C $INNER_GIT_DIR add -A -- "$@" || return
    # --no-textconv: the age textconv would compare plaintexts, so a reencryption looks unchanged.
    git -C $INNER_GIT_DIR diff --cached --quiet --no-textconv || git -C $INNER_GIT_DIR commit -m $msg
}

_create_tmpdir() {
    [[ -n $SECURE_TMPDIR ]] && return
    SECURE_TMPDIR=$(mktemp -d /dev/shm/pass.XXXXXXXXXXXXX) || _die "/dev/shm NOT AVAILABLE"
}

_clip() {
    pkill -f '^passage-clip' 2>/dev/null && sleep 0.5
    print -rn -- $1 | wl-copy || _die "CLIPBOARD COPY FAILED"
    # Clears only if the clipboard still holds this password.
    {
        ( exec -a passage-clip sleep $CLIP_TIME )
        [[ $(wl-paste -n 2>/dev/null) == "$1" ]] && wl-copy --clear
    } &>/dev/null &!
    _info "COPIED '$2' TO CLIPBOARD (CLEARED IN $CLIP_TIME SECONDS)"
}

_reencrypt_path() {
    local f rc=0
    local -a files=($1(.N))
    [[ -d $1 ]] && files=($1/**/*.age(.N))
    for f in $files; do
        if _encrypt $f _decrypt $f; then
            print -r -- "$f: REENCRYPTED WITH: age $AGE_RECIPIENT_ARGS"
        else
            print -ru2 -- "$f: REENCRYPTION FAILED"; rc=1
        fi
    done
    return rc
}

_show() {
    # Hand-parsed: the line number must be attached (-c2), and zparseopts would
    # take the next word, the entry name, as the optional argument of -c.
    local arg target= file pass line= clip=0 qr=0
    for arg; do
        case $arg in
            -c*) clip=1; line=${arg#-c} ;;
            -q*) qr=1; line=${arg#-q} ;;
            *) target=$arg ;;
        esac
    done
    _check_path $target
    file=$PREFIX/$target.age
    if [[ -f $file ]]; then
        if (( clip || qr )); then
            line=${line:-1}
            [[ $line == <1-> ]] || _die "'$line' IS NOT A LINE NUMBER"
            pass=$(_decrypt $file | sed -n "${line}p") || _die "DECRYPTING FAILED"
            [[ -n $pass ]] || _die "LINE $line IS EMPTY"
            (( clip )) && _clip $pass $target
            (( qr )) && print -rn -- $pass | $QRENCODE
        else
            pass=$(_decrypt $file) || _die "DECRYPTING FAILED"
            print -r -- $pass
        fi
    fi
    if [[ -d $PREFIX/$target ]]; then
        local -a entries=($PREFIX/$target/**/*.age(.N))
        print -rl -- ${${entries#$PREFIX/$target/}%.age}
    elif [[ ! -f $file ]]; then
        _die "'$target' NOT FOUND IN STORE"
    fi
}

_add() {
    local -a multi force
    zparseopts -D -E -F -- m=multi f=force || exit 1
    _target ${1-}
    (( $#force )) || _confirm_overwrite
    if (( $#multi )); then
        print "PRESS CTRL+D WHEN FINISHED:"
        _encrypt $FILE cat || _die "ENCRYPTION FAILED"
    else
        local pass check
        read -rs "pass?ENTER PASSPHRASE: " && print || { print; exit 1 }
        read -rs "check?RETYPE PASSPHRASE: " && print || { print; exit 1 }
        [[ -n $pass ]] || _die "EMPTY PASSPHRASE"
        [[ $pass == "$check" ]] || _die "PASSPHRASES DO NOT MATCH"
        _encrypt $FILE print -rn -- $pass || _die "ENCRYPTION FAILED"
    fi
    _git_commit "Add given password for '$TARGET' to store." $FILE
}

_edit() {
    _target ${1-}
    _create_tmpdir
    local tmp=$SECURE_TMPDIR/${TARGET//\//-}.txt action=Add before=
    if [[ -f $FILE ]]; then
        _decrypt -o $tmp $FILE || _die "DECRYPTING FAILED"
        action=Edit
        before=$(sha256sum < $tmp)
    fi
    ${=EDITOR:-vi} $tmp || _die "EDITOR FAILED"
    [[ -f $tmp ]] || _die "NEW PASSWORD NOT SAVED"
    [[ $(sha256sum < $tmp) == "$before" ]] && { _info "PASSWORD UNCHANGED"; return 0 }
    _encrypt $FILE cat -- $tmp || _die "ENCRYPTION FAILED"
    _git_commit "$action password for $TARGET using ${EDITOR:-vi}." $FILE
}

_replace_first_line() {
    print -r -- $1
    _decrypt $2 | tail -n +2
}

_generate() {
    local -a force inplace
    zparseopts -D -E -F -- f=force i=inplace || exit 1
    _target ${1-}
    local pass verb=Add
    (( $#inplace || $#force )) || _confirm_overwrite
    read -r -k $GEN_LENGTH -u 0 pass < <(LC_ALL=C tr -dc $GEN_CHARS < /dev/urandom)
    (( $#pass == GEN_LENGTH )) || _die "PASSWORD GENERATION FAILED"
    if (( $#inplace )); then
        [[ -f $FILE ]] || _die "'$TARGET' NOT FOUND IN STORE"
        _encrypt $FILE _replace_first_line $pass $FILE || _die "REENCRYPTION FAILED"
        verb=Replace
    else
        _encrypt $FILE print -r -- $pass || _die "ENCRYPTION FAILED"
    fi
    _git_commit "$verb generated password for $TARGET." $FILE
    print -r -- $'\e[1m'"THE GENERATED PASSWORD FOR $TARGET IS:"$'\e[0m'
    print -r -- $'\e[1;93m'"$pass"$'\e[0m'
}

_reencrypt() {
    [[ -n ${1-} ]] || _die "NO TARGET SPECIFIED"
    _check_path $1
    local dir=$PREFIX/${1%/}
    [[ -d $dir ]] || _die "'$dir' NOT A FOLDER"
    _reencrypt_path $dir
    _git_commit "Reencrypt $1." $dir
}

_rm() {
    _target ${1-}
    [[ -f $FILE ]] || _die "'$TARGET' NOT FOUND IN STORE"
    rm -i -v -- $FILE || exit 1
    [[ -e $FILE ]] && exit 1
    _git_commit "Remove $TARGET from store." $FILE
    rmdir -p -- ${FILE:h} 2>/dev/null
    return 0
}

_mv() {
    (( $# == 2 )) || _die "USAGE: pass mv SOURCE TARGET"
    _check_path $1 $2
    local old=$PREFIX/${1%/} new=$PREFIX/$2
    # A trailing slash on SOURCE selects the folder when an entry and a folder share the name.
    [[ -f $old.age && ! ( -d $old && $1 == */ ) ]] && old=$old.age
    [[ -e $old ]] || _die "'$1' NOT FOUND IN STORE"
    [[ -d $old || -d $new || $new == */ ]] || new=$new.age
    mkdir -p -- ${new%/*}
    mv -i -v -- $old $new || exit 1
    [[ -e $old ]] && exit 1
    _reencrypt_path $new
    _git_commit "Rename $1 to $2." $old $new
    rmdir -p -- ${old:h} 2>/dev/null
    return 0
}

_git() {
    if [[ ${1-} == init ]]; then
        INNER_GIT_DIR=$PREFIX
        git -C $PREFIX "$@" || exit 1
        print '*.age diff=age' > $PREFIX/.gitattributes
        git -C $PREFIX config --local diff.age.binary true
        git -C $PREFIX config --local diff.age.textconv "age -d -i ${(q)IDENTITIES_FILE}"
        _git_commit "Add current contents of password store." $PREFIX
    elif [[ -n $INNER_GIT_DIR ]]; then
        _create_tmpdir
        TMPDIR=$SECURE_TMPDIR git -C $INNER_GIT_DIR "$@"
    else
        _die "NOT A GIT REPOSITORY"
    fi
}

[[ -f $IDENTITIES_FILE ]] || _die "IDENTITIES FILE NOT FOUND!"
git -C $PREFIX rev-parse --is-inside-work-tree &>/dev/null && INNER_GIT_DIR=$PREFIX

case ${1-} in
    show|add|edit|generate|reencrypt|mv|rm|git) cmd=$1; shift; _$cmd "$@" ;;
    *) _show "$@" ;;
esac
