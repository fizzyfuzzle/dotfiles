{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "platformCommit": "enabled",
  "schedule": ["before 6am on monday"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "chezmoi git-repo externals (zsh/vim plugins) pinned by commit SHA, default branch read from a `# renovate: branch=...` comment next to each pin",
      "managerFilePatterns": [
        "/^\\.chezmoiexternal\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "url = \"https://github\\.com/(?<depName>[^\"]+)\\.git\"\\n\\s*revision = \"(?<currentDigest>[0-9a-f]{40})\" # renovate: branch=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-digest",
      "packageNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "chezmoi archive externals (age, age-plugin-yubikey) pinned by tag + sha256 checksum of the release asset",
      "managerFilePatterns": [
        "/^\\.chezmoiexternal\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "gitHubReleaseAssetURL \"(?<depName>[^\"]+)\" \"(?<currentValue>[^\"]+)\" \"[^\"]+\"[\\s\\S]*?checksum\\.sha256 = \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
